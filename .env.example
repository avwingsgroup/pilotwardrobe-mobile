# Copy to .env.development.local / .env.staging.local / .env.production.local and adjust.
# Every VITE_ value is compiled into the app bundle and is PUBLIC. Never put secrets here
# (no payment, Cloudinary, Prembly, Termii, Twilio or Firebase server keys).

# development | staging | production
VITE_APP_ENV=development

# Laravel host WITHOUT the /api/vN suffix. The client appends /api/${VITE_API_VERSION}.
VITE_API_BASE_URL=https://pilotwardrobe-api.test
VITE_API_VERSION=v1

# Public web app (APP_FRONTEND_URL on the backend). Payment return URLs, shared listing
# links and universal/app links are built from it.
VITE_WEB_APP_URL=http://localhost:5173

# Browser dev server only: proxy /api to VITE_API_BASE_URL to avoid CORS during `npm run dev`.
VITE_DEV_PROXY=true

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=20000

# Optional: sends structured error reports to this endpoint when set (no PII).
VITE_ERROR_REPORTING_URL=

# Push notifications (FCM). Enable only when the native Firebase config files are in place.
VITE_PUSH_ENABLED=false
